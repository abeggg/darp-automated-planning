(define (problem darp-temporal-example)
  (:domain darp-temporal)
  (:objects
    v1 - vehicle
    p1 p2 - passenger
    depot a b c d - location
  )
  (:init
    (at-vehicle v1 depot)
    (waiting p1 a)
    (waiting p2 c)
    (destination p1 b)
    (destination p2 d)
    (connected depot a) (connected a depot)
    (connected depot c) (connected c depot)
    (connected a b) (connected b a)
    (connected a c) (connected c a)
    (connected b c) (connected c b)
    (connected b d) (connected d b)
    (connected c d) (connected d c)
    (= (travel-time depot a) 4) (= (travel-time a depot) 4)
    (= (travel-time depot c) 6) (= (travel-time c depot) 6)
    (= (travel-time a b) 5) (= (travel-time b a) 5)
    (= (travel-time a c) 3) (= (travel-time c a) 3)
    (= (travel-time b c) 4) (= (travel-time c b) 4)
    (= (travel-time b d) 4) (= (travel-time d b) 4)
    (= (travel-time c d) 5) (= (travel-time d c) 5)
    (= (load v1) 0)
    (= (capacity v1) 2)
    (available v1)
    (= (total-travel) 0)
    (ready p1)
    (at 8 (ready p2))
  )
  (:goal (and (served p1) (served p2)))
  (:metric minimize (total-time))
)
