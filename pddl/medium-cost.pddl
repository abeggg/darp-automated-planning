(define (problem darp-medium-cost)
  (:domain darp-cost)
  (:objects
    v1 - vehicle
    p1 p2 p3 - passenger
    l0 l1 l2 l3 l4 - location
    s1_1 s1_2 - seat
  )
  (:init
    (at-vehicle v1 l0)
    (at-passenger p1 l1)
    (origin p1 l1)
    (destination p1 l3)
    (at-passenger p2 l2)
    (origin p2 l2)
    (destination p2 l4)
    (at-passenger p3 l4)
    (origin p3 l4)
    (destination p3 l1)
    (slot-of s1_1 v1)
    (free s1_1)
    (slot-of s1_2 v1)
    (free s1_2)
    (connected l0 l1)
    (connected l0 l2)
    (connected l0 l3)
    (connected l0 l4)
    (connected l1 l0)
    (connected l1 l2)
    (connected l1 l3)
    (connected l1 l4)
    (connected l2 l0)
    (connected l2 l1)
    (connected l2 l3)
    (connected l2 l4)
    (connected l3 l0)
    (connected l3 l1)
    (connected l3 l2)
    (connected l3 l4)
    (connected l4 l0)
    (connected l4 l1)
    (connected l4 l2)
    (connected l4 l3)
    (= (total-cost) 0)
    (= (travel-cost l0 l1) 2)
    (= (travel-cost l0 l2) 5)
    (= (travel-cost l0 l3) 7)
    (= (travel-cost l0 l4) 5)
    (= (travel-cost l1 l0) 2)
    (= (travel-cost l1 l2) 3)
    (= (travel-cost l1 l3) 5)
    (= (travel-cost l1 l4) 4)
    (= (travel-cost l2 l0) 5)
    (= (travel-cost l2 l1) 3)
    (= (travel-cost l2 l3) 3)
    (= (travel-cost l2 l4) 6)
    (= (travel-cost l3 l0) 7)
    (= (travel-cost l3 l1) 5)
    (= (travel-cost l3 l2) 3)
    (= (travel-cost l3 l4) 5)
    (= (travel-cost l4 l0) 5)
    (= (travel-cost l4 l1) 4)
    (= (travel-cost l4 l2) 6)
    (= (travel-cost l4 l3) 5)
  )
  (:goal (and (served p1) (served p2) (served p3)))
  (:metric minimize (total-cost))
)
